APP_NAME=SmashRank
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smashrank
DB_USERNAME=smashrank_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
# Trên VPS thực tế, đổi sang SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=app-password
# MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# ---- Dịch thuật sản phẩm EN→ZH (sync badmintoncn) — tùy chọn ----
# Không có key thì dùng bảng thuật ngữ tích hợp sẵn trong TranslationService
GOOGLE_TRANSLATE_API_KEY=

# ---- Google Drive Backup (OAuth2 refresh token) ----
# Hướng dẫn lấy credentials: docs/BACKUP_GOOGLE_DRIVE.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
BACKUP_MYSQLDUMP_PATH=mysqldump

# ---- Web Push (PWA) — sinh key: npx web-push generate-vapid-keys ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com

# ---- Crawl tự động (mặc định TẮT — kiểm tra robots.txt trước khi bật) ----
AUTO_CRAWL_ENABLED=false
BACKUP_MYSQL_PATH=mysql
